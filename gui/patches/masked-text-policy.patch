+// Masked display uses one ASCII placeholder per Unicode codepoint. These
+// helpers accept the same valid UTF-8 as TextPolicy and retain source byte
+// offsets independently of the obscured display's byte offsets.
+inline std::size_t text_display_offset(std::string_view value,const TextPolicy& policy,std::size_t source_offset) {
+    source_offset=text_boundary(value,source_offset);
+    if(!policy.masked)return source_offset;
+    std::size_t count=0;
+    for(std::size_t at=0;at<source_offset;++count) {
