+void Probe::pointer_phase(Adapter& adapter,PointerKind kind,Point point,unsigned clicks) {
+    adapter.sync();if(adapter.closed())return;
+    auto& window=*adapter.impl_->window;auto& event=window.event;event.resetBeforeDispatch();
+    event.mouse.pos={float(point.x),float(point.y)};
+    event.mouse.lb.pressTimeDiff=clicks>1?0:1000;event.mouse.lb.pressPosDiff={0,0};
+    if(kind==PointerKind::press) {event.mouse.lb.id=1;event.mouse.down=event.mouse.pos;}
+    else if(kind==PointerKind::release) {event.mouse.lb.id=-1;event.mouse.up=event.mouse.pos;}
+    window.setTargets(event);
+    if(kind==PointerKind::press)window.mouseDown(event);
+    else if(kind==PointerKind::release)window.mouseUp(event);
+    else if(kind==PointerKind::move)window.mouseMove(event);
+    else if(kind==PointerKind::cancel) {window.onDefocus();event.mouse.lb.id=0;}
+    else throw std::invalid_argument("Expected physical pointer phase");
