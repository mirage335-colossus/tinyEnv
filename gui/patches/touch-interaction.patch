+    std::optional<PointerTarget> pointer_target(Point position) const {
+        if(prompt_) {
+            const auto prefix="prompt:"+std::to_string(prompt_->id)+":";
+            if(contains(prompt_cancel_bounds(),position))return PointerTarget{{},prefix+"cancel"};
+            if(contains(prompt_accept_bounds(),position))return PointerTarget{{},prefix+"accept"};
+            if(contains(prompt_field_bounds(),position))return PointerTarget{{},prefix+"field"};
+            return std::nullopt;
+        }
+        if(popup_) {
+            const auto area=popup_bounds();
+            if(!contains(area,position))return PointerTarget{popup_->key,"popup:outside"};
+            const auto index=std::min(popup_->options.size()-1,static_cast<std::size_t>((position.y-area.y)/popup_row_height()));
+            return PointerTarget{popup_->key,"popup:"+popup_->options[index].id};
+        }
+        for(const auto& [page,area]:page_bounds())if(page.enabled&&contains(area,position))
