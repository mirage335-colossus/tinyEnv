+def renderer_script_hash():
+    """Read generated data without executing renderer code in the host."""
+    path = ASSETS / "renderer_child_bundle.mjs"
+    if path.is_symlink() or not path.is_file() or path.stat().st_size > 16 * 1024 * 1024:
+        raise ValueError("Retained renderer bundle is missing or invalid")
+    lines = path.read_text(encoding="utf-8").splitlines()
+    names = ("CHILD_SCRIPT", "CHILD_SCRIPT_SHA256", "CHILD_CSP", "CHILD_SANDBOX",
+             "CHILD_PROTOCOL", "CHILD_STYLE", "CHILD_INPUTS")
+    if len(lines) != len(names) + 1 or lines[0] != "// Generated renderer data; never evaluate this script in the parent.":
+        raise ValueError("Invalid generated renderer data")
+    values = {}
+    for name, line in zip(names, lines[1:]):
+        prefix = "export const " + name + "="
+        if not line.startswith(prefix) or not line.endswith(";"):
+            raise ValueError("Invalid generated renderer export")
+        values[name] = json.loads(line[len(prefix):-1])
+    canonical = (lines[0] + "\n" + "".join("export const " + name + "=" +
+                 json.dumps(values[name], ensure_ascii=True, separators=(",", ":")) + ";\n" for name in names))
+    if canonical != path.read_text(encoding="utf-8") or any(not isinstance(values[name], str) for name in names[:-1]):
+        raise ValueError("Invalid renderer data or script")
+    actual = base64.b64encode(hashlib.sha256(values["CHILD_SCRIPT"].encode("utf-8")).digest()).decode("ascii")
+    if (values["CHILD_SCRIPT_SHA256"] != actual or values["CHILD_SANDBOX"] != "allow-scripts" or
+            values["CHILD_PROTOCOL"] != "foundation-renderer-v1"):
+        raise ValueError("Renderer bundle policy differs")
+    expected_policy = ("default-src 'none'; script-src 'sha256-" + actual + "'; "
+                       "connect-src 'none'; worker-src 'none'; style-src 'unsafe-inline'; "
+                       "img-src data:; object-src 'none'; base-uri 'none'; form-action 'none'; "
+                       "frame-src 'none'; child-src 'none'")
+    if values["CHILD_CSP"] != expected_policy:
+        raise ValueError("Renderer content policy differs")
+    return actual
 
 
