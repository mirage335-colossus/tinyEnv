    {"target": "linux-aarch64", "host_system": "Linux", "host_processor": "aarch64", "os": "debian-12", "backends": ["terminal", "framebuffer", "fltk", "rev", "sdl", "hosted-web"], "core_cli": true, "sdk_target_system": "Linux", "sdk_processor": "aarch64", "python_minimum": "3.9", "acceptance": "bookworm-isolated"},
